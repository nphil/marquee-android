<?xml version="1.0" encoding="utf-8"?>
<!-- The iPhone app's icon (core/Resources/AppIcon-1024.png): the M cut from its background onto the
     same colour, inside the adaptive icon's safe zone. The monochrome layer keeps the folds as alpha so a
     themed icon still reads as the folded M. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
