<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in is sealed with a key that never leaves this device, and the client identifier names
     this install to Plex, so neither is backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
